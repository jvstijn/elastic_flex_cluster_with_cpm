# Kopieer naar .env en vul de wachtwoorden in. Houd ELASTIC_PASSWORD /
# KIBANA_PASSWORD / LOGSTASH_PASSWORD / MONITORING_PASSWORD gelijk aan
# docker-local/.env als je beide stacks naast elkaar draait; dat scheelt
# verwarring en de acc-stack gebruikt dezelfde beat/logstash-gebruikersnamen.

ELASTIC_PASSWORD=
KIBANA_PASSWORD=
LOGSTASH_PASSWORD=
MONITORING_PASSWORD=

STACK_VERSION=9.4.1
LICENSE=trial

# Hostpoorten — bewust naast die van docker-local (9200-9202 / 5601)
ES_ACC_CENTRAL_PORT=9210
ES_ACC_REMOTE_A_PORT=9211
ES_ACC_REMOTE_B_PORT=9212
ES_ACC_MONITORING_PORT=9213
KIBANA_ACC_PORT=5602

MEM_LIMIT=1073741824

# Het docker-netwerk waar Kafka van docker-local aan hangt. Controleer met
#   docker network ls | grep dod-elastic
KAFKA_NETWORK=dod-elastic_dod-elastic

# Per-cluster ingest-API-keys. init-stack.sh maakt deze aan en schrijft de
# waarden hieronder terug in .env; daarna de logstash-services herstarten.
VAR_API_KEY_ACC_CENTRAL=
VAR_API_KEY_ACC_REMOTE_A=
VAR_API_KEY_ACC_REMOTE_B=

# Kafka-bootstrap voor de gerenderde CPM-pipelines. Eén Kafka-cluster, dus dhl
# en mld wijzen naar dezelfde brokers (net als in docker-local).
VAR_BOOTSTRAP_SERVERS_DHL=kafka:9092
VAR_BOOTSTRAP_SERVERS_MLD=kafka:9092
VAR_CLIENT_ID=cpm-logstash-acc
VAR_SSL_TRUSTSTORE_LOCATION=
VAR_SSL_KEYSTORE_LOCATION=
VAR_CA_TRUSTED_FINGERPRINT=
