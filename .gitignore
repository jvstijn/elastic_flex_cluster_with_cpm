# Kibana checkout used only for plugin builds
.kibana-build/

# Built plugin distributables
kibana_plugin/build/
kibana_plugin/node_modules/
.DS_Store

# Scratch/build artifacts (unzipped plugin, zips) — never track build output
temp/

# Lokale env-bestanden met wachtwoorden/API-keys (incl. Finder-duplicaten als ".env 2")
.env*
!.env.example
