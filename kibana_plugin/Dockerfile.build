# Build CPM Kibana plugin zip only (artifact on host via volume mount).
#
#   docker build -f Dockerfile.build -t cpm-kibana-plugin-build:8.19.16 .
#   docker run --rm -v "$(pwd)/build:/output" cpm-kibana-plugin-build:8.19.16
#
# Or use: ../scripts/build_kibana_cpm_plugin_docker.sh

ARG KIBANA_VERSION=8.19.16

FROM node:22.22.2-bookworm-slim
ARG KIBANA_VERSION
ENV KIBANA_VERSION=${KIBANA_VERSION}

RUN apt-get update \
  && apt-get install -y --no-install-recommends git python3 build-essential ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /kibana
RUN git clone --depth 1 --branch "v${KIBANA_VERSION}" https://github.com/elastic/kibana.git .
# Bootstrap and plugin build both as root — avoids corepack re-downloading Yarn for USER node.
RUN corepack enable \
  && corepack prepare yarn@1.22.21 --activate \
  && yarn kbn bootstrap --skip-os-packages --allow-root

COPY cpm /kibana/plugins/cpm
WORKDIR /kibana/plugins/cpm
RUN yarn build

RUN mkdir -p /output

ENTRYPOINT ["sh", "-c", "cp \"/kibana/plugins/cpm/build/cpm-${KIBANA_VERSION}.zip\" /output/ && ls -la \"/output/cpm-${KIBANA_VERSION}.zip\""]
